<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!--
      WAKE_LOCK 是必须的：AudioRecv/AudioSend 会各拿一个 WifiLock，
      让 Wi-Fi 在息屏后别进省电模式（省电模式会把抖动缓冲冲垮，听感就是一顿一顿）。
      忘了声明它时，真机上会看到 "Neither user ... has android.permission.WAKE_LOCK"
      —— 这是 2026-10-12 真机反馈里抓到的第二个 bug。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!--
      MEDIA_PROJECTION：用来采集【本机正在播放的声音】（音乐/视频/游戏），
      也就是这个 App 真正的用途 —— 早期版本只采了麦克风，那是"对讲机"不是音频投射，
      用户明确指出过这个方向性错误。
      为此需要前台服务带上 mediaProjection 类型：targetSdk 34 下，
      没在已启动的 mediaProjection 类型前台服务里调用 getMediaProjection() 会直接抛异常。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application android:label="Audio Mixing" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
                  android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          前台服务：手机当节点时，App 切到后台也要继续收发声音。
          type = mediaPlayback（播别人的声音）+ microphone（对讲用的麦克风）
                 + mediaProjection（采本机正在播放的声音，见上面的权限说明）。
          三个都要声明：targetSdk 34 起，startForeground 带的类型必须与清单一致，
          缺一个就在那一条路上抛 SecurityException。
        -->
        <service android:name=".MixService" android:exported="false"
                 android:foregroundServiceType="mediaPlayback|microphone|mediaProjection"/>
    </application>
</manifest>
